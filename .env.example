# Copie para .env e preencha os valores.
# Não use comentários na mesma linha do valor (# quebra o parse).

APP_ENV=development

# Google Workspace
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GOOGLE_SUBJECT_EMAIL=automation@example.com
GOOGLE_GROUP_KEY=oncall@example.com

# Incident.io (API key com acesso a schedules e alerts.view para dailyAlerts)
INCIDENT_API_KEY=
INCIDENT_SCHEDULE_PRIMARY=
INCIDENT_SCHEDULE_SECONDARY=

# Slack — bot Oncall Updater
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID_OPERATION=
SLACK_GROUP_ID_UPDATE_ONCALL=

# Slack user IDs (perfil → ⋮ → Copiar identificador do membro). Formato: Uxxxxxxxx
# Sempre no @ do grupo de plantão
SLACK_ADDITIONAL_USERS_GROUP=

# Alertas firing (dailyAlerts)
INCIDENT_ALERT_ATTRIBUTE_ID=
INCIDENT_ALERT_CATALOG_IDS=
INCIDENT_ALERT_STATUS=firing
INCIDENT_ALERT_DAYS=21
INCIDENT_ALERT_TIMEZONE=UTC

# Resumo semanal GCP / Kubernetes (weeklyGcp)
# Planilha preenchida pelo Apps Script (scripts/gmail-digest.gs) segunda 08:45 Recife.
# Criar o CronJob em manifestos/cronjob-weekly-gcp.yaml (segunda 09:00 Recife).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GCP_EMAIL_SHEET_ID=
GCP_EMAIL_SHEET_RANGE=Emails!A2:F
